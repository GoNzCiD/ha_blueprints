blueprint:
  name: Notificación de Progreso de Impresora Elegoo (v8 - Español)
  description: Envía notificaciones enriquecidas sobre el progreso de la impresora, cambios de estado y estados de error críticos.
  author: Daniel Cherubini (Traducido al Español)
  homeassistant:
    min_version: 2024.6.0
  domain: automation
  input:
    percent_complete_entity:
      name: Entidad de porcentaje completado
      description: El sensor de porcentaje completado de la impresora Elegoo (busca entidades que terminen en '_percent_complete').
      selector:
        entity:
          domain: sensor
          integration: elegoo_printer
    print_status_entity:
      name: Entidad de estado de impresión
      description: El sensor de estado de la impresión (debería terminar en '_print_status').
      selector:
        entity:
          domain: sensor
          integration: elegoo_printer
          device_class: enum
    current_status_entity:
      name: Entidad de estado actual
      description: El sensor de estado actual general (debería terminar en '_current_status').
      selector:
        entity:
          domain: sensor
          integration: elegoo_printer
          device_class: enum
    error_status_reason_entity:
      name: Entidad de razón del error
      description: El sensor de motivo de error (debería terminar en '_current_print_error_status_reason').
      selector:
        entity:
          domain: sensor
          integration: elegoo_printer
          device_class: enum
    notify_device:
      name: Dispositivo de notificación
      description: El dispositivo que recibirá las notificaciones (ej. Tu teléfono).
      selector:
        device:
          integration: mobile_app
    percent_every:
      name: Frecuencia de notificación de progreso
      description: >-
        Envía una notificación de progreso cada N por ciento completado.
        10 notificará al 10%, 20%, 30%…100% (por defecto). 1 = cada 1%.
      default: "10"
      selector:
        select:
          options:
            - "1"
            - "2"
            - "5"
            - "10"
            - "20"
    camera_entity:
      name: Cámara de la impresora (Opcional)
      description: Forzar una entidad de cámara específica para la impresora. Déjalo en blanco para usar la cámara por defecto del dispositivo de la impresora.
      default: ""
      selector:
        entity:
          domain: camera
    dashboard_url:
      name: URL del panel de control (Opcional)
      description: La ruta que se abrirá al pulsar la notificación (ej. '/dashboard-ejemplo/impresora', no la URL completa).
      default: ""
    enable_status_notifications:
      name: Habilitar notificaciones de cambio de estado
      description: Enviar notificaciones cuando cambie el estado de la impresora (ej. homing, calentando, etc.)
      default: true
      selector:
        boolean:

mode: single
max_exceeded: silent

variables:
  percent_complete_entity: !input percent_complete_entity
  notify_device: !input notify_device
  percent_every: !input percent_every
  camera_entity_input: !input camera_entity
  dashboard_url: !input dashboard_url
  enable_status_notifications: !input enable_status_notifications
  print_status_entity: !input print_status_entity
  current_status_entity: !input current_status_entity
  error_status_reason_entity: !input error_status_reason_entity
  # Obtener el ID del dispositivo a través de la entidad de porcentaje
  printer_device: >-
    {{ device_id(percent_complete_entity) }}
  notification_group: >-
    {{ device_attr(printer_device, 'name') | slugify }}
  # Auto-detección de entidades secundarias del mismo dispositivo
  end_time_entity: >-
    {{ device_entities(printer_device) | select('search', '_end_time') |
    first }}
  file_name_entity: >-
    {{ device_entities(printer_device) | select('search', '_file_name') |
    first }}
  current_layer_entity: >-
    {{ device_entities(printer_device) | select('search', '_current_layer') |
    first }}
  total_layers_entity: >-
    {{ device_entities(printer_device) | select('search', '_total_layers') |
    first }}
  camera_entity: >-
    {{ (camera_entity_input
        if camera_entity_input != ''
        else (device_entities(printer_device) | select('match', '^camera\.') | first))
       | default('', true) }}

triggers:
  - trigger: state
    entity_id: !input percent_complete_entity
  - trigger: state
    entity_id: !input print_status_entity
  - trigger: state
    entity_id: !input current_status_entity
  - trigger: state
    entity_id: !input error_status_reason_entity

condition: []

action:
  - choose:
      # --- NOTIFICACIÓN DE PROGRESO DE IMPRESIÓN (Cada X%) ---
      - conditions:
          - condition: template
            value_template: "{{ trigger.entity_id == percent_complete_entity }}"
          - condition: template
            value_template: "{{ states(percent_complete_entity) not in ['unknown', 'unavailable'] }}"
          - condition: template
            value_template: "{{ states(percent_complete_entity) | int(0) < 100 }}"
          - condition: template
            value_template: >-
              {{ states(percent_complete_entity) | int(0) > 0
                 and states(percent_complete_entity) | int(0) % (percent_every | int) == 0 }}
          - condition: template
            value_template: >-
              {{ print_status_entity != none and states(print_status_entity) == 'printing' }}
          - condition: template
            value_template: "{{ notify_device != '' }}"
        sequence:
          - device_id: !input notify_device
            domain: mobile_app
            type: notify
            title: "Imprimiendo: {{ states(percent_complete_entity) | int(0) }}%\nCapa: {{ (states(current_layer_entity)|default('?', true)) }}/{{ (states(total_layers_entity)|default('?', true)) }}"
            message: "{{ states(file_name_entity)|default('Archivo desconocido', true) }}"
            data:
              chronometer: true
              when: "{{ as_timestamp(states(end_time_entity))|int if end_time_entity != none and states(end_time_entity) not in ['unknown', 'unavailable'] else 0 }}"
              progress: "{{ states(percent_complete_entity)|int(0) }}"
              progress_max: 100
              image: "{{ ('/api/camera_proxy/' ~ camera_entity) if (camera_entity|default('', true)) != '' else '' }}"
              url: "{{ dashboard_url }}"
              clickAction: "{{ dashboard_url }}"
              group: "{{ notification_group }}"
              channel: "{{ notification_group }}"
              tag: "{{ notification_group }}"
              alert_once: true
              sticky: true
              push:
                interruption-level: passive

      # --- NOTIFICACIÓN DE IMPRESIÓN FINALIZADA ---
      - conditions:
          - condition: template
            value_template: "{{ notify_device != '' }}"
          - condition: template
            value_template: "{{ states(print_status_entity) == 'complete' }}"
          - condition: or
            conditions:
              - condition: and
                conditions:
                  - condition: template
                    value_template: "{{ trigger.entity_id == print_status_entity }}"
                  - condition: template
                    value_template: "{{ trigger.from_state.state != 'complete' }}"
              - condition: and
                conditions:
                  - condition: template
                    value_template: "{{ trigger.entity_id == percent_complete_entity }}"
        sequence:
          - device_id: !input notify_device
            domain: mobile_app
            type: notify
            title: "🎉 ¡Impresión Finalizada!"
            message: "La pieza se ha completado con éxito."
            data:
              image: "{{ ('/api/camera_proxy/' ~ camera_entity) if (camera_entity|default('', true)) != '' else '' }}"
              url: "{{ dashboard_url }}"
              clickAction: "{{ dashboard_url }}"
              group: "{{ notification_group }}"
              channel: "{{ notification_group }}"
              tag: "{{ notification_group }}"
              sticky: true
              alert_once: true
              push:
                interruption-level: time-sensitive

      # --- NOTIFICACIÓN POR CAMBIO DE ESTADO DE LA IMPRESIÓN ---
      - conditions:
          - condition: template
            value_template: "{{ trigger.entity_id == print_status_entity }}"
          - condition: template
            value_template: "{{ notify_device != '' }}"
          - condition: template
            value_template: "{{ enable_status_notifications }}"
          - condition: template
            value_template: >-
              {{ states(print_status_entity) not in ['complete', 'stopped', 'stopping', 'idle', 'unknown', 'unavailable'] }}
        sequence:
          - device_id: !input notify_device
            domain: mobile_app
            type: notify
            title: "Actualización del estado de la impresora"
            message: >-
              {% set status = states(print_status_entity) %}
              {% set file_name = states(file_name_entity)|default('Archivo desconocido', true) %}
              {% if status == 'homing' %}
                🏠 La impresora está realizando el home
              {% elif status == 'printing' %}
                🖨️ Impresión iniciada: {{ file_name }}
              {% elif status == 'paused' or status == 'pausing' %}
                ⏸️ Impresión pausada: {{ file_name }}
              {% elif status == 'loading' %}
                📥 Cargando filamento
              {% elif status == 'dropping' %}
                🔽 Bajando la plataforma
              {% elif status == 'lifting' %}
                🔼 Subiendo la plataforma
              {% elif status == 'file_checking' %}
                📁 Comprobando el archivo de impresión
              {% elif status == 'recovery' or status == 'printing_recovery' %}
                🔄 Recuperación de impresión en progreso
              {% elif status == 'preheating' %}
                🔥 Precalentando para la impresión
              {% elif status == 'leveling' %}
                📐 Nivelación de la cama en progreso
              {% else %}
                📊 Estado: {{ status }}
              {% endif %}
            data:
              url: "{{ dashboard_url }}"
              clickAction: "{{ dashboard_url }}"
              group: "{{ notification_group }}"
              channel: "{{ notification_group }}"
              tag: "{{ notification_group }}_status"
              alert_once: true
              push:
                interruption-level: passive

      # --- NOTIFICACIÓN POR CAMBIO DE ESTADO ACTUAL DE LA MÁQUINA ---
      - conditions:
          - condition: template
            value_template: "{{ trigger.entity_id == current_status_entity }}"
          - condition: template
            value_template: "{{ notify_device != '' }}"
          - condition: template
            value_template: "{{ enable_status_notifications }}"
          - condition: template
            value_template: "{{ states(current_status_entity) not in ['idle', 'printing', 'unknown', 'unavailable'] }}"
        sequence:
          - device_id: !input notify_device
            domain: mobile_app
            type: notify
            title: "Actualización del estado de la máquina"
            message: >-
              {% set status = states(current_status_entity) %}
              {% set file_name = states(file_name_entity)|default('Archivo desconocido', true) %}
              {% if status == 'file_transferring' %}
                📁 Transferencia de archivo en progreso
              {% elif status == 'exposure_testing' %}
                🔬 Prueba de exposición en ejecución
              {% elif status == 'devices_testing' %}
                🔧 Autocomprobación del dispositivo en ejecución
              {% elif status == 'leveling' %}
                📐 Nivelación de la cama en progreso
              {% elif status == 'loading_unloading' %}
                📥📤 Cargando/descargando filamento
              {% else %}
                📊 Estado de la máquina: {{ status }}
              {% endif %}
            data:
              url: "{{ dashboard_url }}"
              clickAction: "{{ dashboard_url }}"
              group: "{{ notification_group }}"
              channel: "{{ notification_group }}"
              tag: "{{ notification_group }}_machine_status"
              alert_once: true
              push:
                interruption-level: passive

      # --- GESTIÓN DE ERRORES CRÍTICOS DE LA IMPRESORA ---
      - conditions:
          - condition: template
            value_template: "{{ trigger.entity_id == error_status_reason_entity }}"
          - condition: template
            value_template: "{{ notify_device != '' }}"
          - condition: template
            value_template: >-
              {{ states(error_status_reason_entity) not in ['ok', 'none', 'unknown', 'unavailable'] }}
        sequence:
          - device_id: !input notify_device
            domain: mobile_app
            type: notify
            title: "🚨 ¡Error Crítico en la Impresora!"
            message: >-
              {% set error = states(error_status_reason_entity) %}
              {% set file_name = states(file_name_entity)|default('la impresión actual', true) %}
              {% if error == 'filament_runout' %}
                🧵 ¡Se ha agotado el filamento durante {{ file_name }}! Por favor, carga nuevo filamento.
              {% elif error == 'filament_about_to_runout' %}
                ⚠️ ¡Filamento casi agotado en {{ file_name }}! Por favor, prepara un nuevo rollo.
              {% elif error == 'filament_jam' %}
                🚫 ¡Atasco de filamento detectado durante {{ file_name }}! Comprueba el extrusor.
              {% elif error == 'temp_error' %}
                🌡️ ¡Error de temperatura detectado! Por favor, revisa las temperaturas de la boquilla y de la cama.
              {% elif error == 'level_failed' %}
                📐 ¡Falló la nivelación de la cama! Por favor, comprueba el sistema de nivelación.
              {% elif error == 'home_failed' or error == 'home_failed_x' or error == 'home_failed_y' or error == 'home_failed_z' %}
                🏠 ¡Fallo al realizar el home! Revisa los ejes de la impresora y los finales de carrera (endstops).
              {% elif error == 'bed_adhesion_failed' %}
                🛏️ ¡La impresión se ha despegado de la cama durante {{ file_name }}!
              {% elif error == 'move_abnormal' %}
                ⚙️ ¡Se ha detectado un movimiento anormal en el motor!
              {% elif error == 'file_error' %}
                📁 ¡Error en el archivo de impresión durante {{ file_name }}!
              {% elif error == 'udisk_remove' %}
                💾 ¡La unidad USB fue retirada durante la impresión!
              {% elif error == 'nozzle_temp_sensor_offline' %}
                🌡️ ¡El sensor de temperatura de la boquilla está desconectado (offline)!
              {% elif error == 'bed_temp_sensor_offline' %}
                🌡️ ¡El sensor de temperatura de la cama está desconectado (offline)!
              {% elif error == 'camera_error' %}
                📷 ¡Error de conexión con la cámara!
              {% elif error == 'network_error' %}
                🌐 ¡Error de conexión de red!
              {% elif error == 'server_connect_failed' %}
                🖥️ ¡Fallo en la conexión con el servidor!
              {% elif error == 'disconnect_app' %}
                📱 ¡La aplicación de control se desconectó durante la impresión!
              {% else %}
                ⚠️ Error: {{ error }}
              {% endif %}
            data:
              image: "{{ ('/api/camera_proxy/' ~ camera_entity) if (camera_entity|default('', true)) != '' else '' }}"
              url: "{{ dashboard_url }}"
              clickAction: "{{ dashboard_url }}"
              group: "{{ notification_group }}"
              channel: "{{ notification_group }}"
              tag: "{{ notification_group }}_critical_error"
              sticky: true
              alert_once: false
              push:
                interruption-level: time-sensitive
