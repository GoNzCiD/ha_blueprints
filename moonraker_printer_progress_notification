blueprint:
  name: Notificación de Progreso de Impresora Moonraker
  description: Envía notificaciones enriquecidas con imagen de cámara en español sobre el progreso de tu impresora 3D. Incluye corrección inteligente de capas.
  domain: automation
  input:
    notify_device:
      name: Dispositivo de notificación
      description: El dispositivo que recibirá las notificaciones (ej. Tu teléfono).
      selector:
        device:
          integration: mobile_app
    percent_complete_entity:
      name: Sensor de progreso
      description: Entidad que mide el progreso en porcentaje.
      selector:
        entity:
          domain: sensor
    percent_every:
      name: Frecuencia de porcentaje
      description: Notificar cada X por ciento de progreso.
      default: 5
      selector:
        number:
          min: 1
          max: 50
          unit_of_measurement: "%"
    camera_entity:
      name: Cámara web de la impresora
      description: Entidad de la cámara para capturar la imagen actual de la impresión.
      selector:
        entity:
          domain: camera
    print_status_entity:
      name: Sensor de estado de impresión
      description: Entidad que reporta si la máquina está imprimiendo, pausada, etc.
      selector:
        entity:
          domain: sensor
    current_status_entity:
      name: Sensor de estado actual de la impresora
      description: Estado general (ej. operational, printing).
      selector:
        entity:
          domain: sensor
    error_status_reason_entity:
      name: Sensor de mensaje de error
      description: Muestra la razón si ocurre un error.
      selector:
        entity:
          domain: sensor
    percentage_divisor:
      name: Divisor de porcentaje
      description: Configurar si tu sensor de progreso va de 0-100 (poner 1) o de 0-1 (poner 100).
      default: "1"
    enable_status_notifications:
      name: Habilitar notificaciones de estado
      description: Enviar alertas al iniciar, pausar, cancelar o terminar la impresión.
      default: true
      selector:
        boolean: {}
    current_layer_entity:
      name: Sensor de capa actual (Opcional)
      description: Sensor que indica el número de la capa actual.
      default: sensor.centauri_carbon_current_layer
      selector:
        entity:
          domain: sensor
    total_layer_entity:
      name: Sensor de capas totales (Opcional)
      description: Sensor principal que indica las capas totales del archivo.
      default: sensor.centauri_carbon_total_layer
      selector:
        entity:
          domain: sensor
    object_height_entity:
      name: Sensor de altura total del objeto (Opcional)
      description: Respaldo para medir la altura total en mm del objeto.
      default: sensor.centauri_carbon_print_object_height
      selector:
        entity:
          domain: sensor
    layer_height_entity:
      name: Sensor de grosor de capa (Opcional)
      description: Respaldo que lee la altura de cada capa individual en mm.
      default: sensor.centauri_carbon_layer_height
      selector:
        entity:
          domain: sensor
    dashboard_url:
      name: URL del panel de control
      description: Ruta de Lovelace a la que redirigirá al pulsar la notificación.
      default: /lovelace/centauri-carbon

trigger:
  - platform: state
    entity_id: !input percent_complete_entity
    id: progress_changed
  - platform: state
    entity_id: !input print_status_entity
    id: status_changed

condition: []

action:
  - variables:
      layer_current_ent: !input current_layer_entity
      layer_total_ent: !input total_layer_entity
      obj_height_ent: !input object_height_entity
      lay_height_ent: !input layer_height_entity
      status_entity: !input print_status_entity
      enable_status: !input enable_status_notifications

  - choose:
      # --- TRIGGER DE PROGRESO (CADA X%) ---
      - conditions:
          - condition: template
            value_template: "{{ trigger.id == 'progress_changed' }}"
          - condition: template
            value_template: >-
              {% set divisor = states_trigger.input_percent_every | default(5) | int %}
              {% set progreso = (trigger.to_state.state | float(0) * (states_trigger.input_percentage_divisor | float(1))) | int %}
              {{ progreso % divisor == 0 and progreso > 0 and progreso -
              {% set capa_actual = states(layer_current_ent) | int(0) %}
              {% set capa_total_sensor = states(layer_total_ent) %}
              
              {% if capa_total_sensor not in ['unknown', 'unavailable', 'none'] and capa_total_sensor | int(0) > 0 %}
                {% set capas_totales = capa_total_sensor | int %}
              {% else %}
                {% set altura_total = states(obj_height_ent) | float(0) %}
                {% set altura_capa = states(lay_height_ent) | float(0) %}
                {% if altura_capa > 0 and altura_total > 0 %}
                  {% set capas_totales = (altura_total / altura_capa) | round(0) %}
                {% else %}
                  {% set capas_totales = "Desconocido" %}
                {% endif %}
              {% endif %}

              Capa: {{ capa_actual }} / {{ capas_totales }}
            data:
              image: "/api/camera_proxy/{{ json_name(states_trigger.input_camera_entity) }}"
              clickAction: !input dashboard_url

      # --- TRIGGER DE CAMBIO DE ESTADO (INICIO, PAUSA, FIN, ERROR) ---
      - conditions:
          - condition: template
            value_template: "{{ trigger.id == 'status_changed' and enable_status }}"
        sequence:
          - choose:
              # Estado: Completado
              - conditions:
                  - condition: template
                    value_template: "{{ trigger.to_state.state == 'complete' }}"
                sequence:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    title: "🎉 ¡Impresión Finalizada!"
                    message: "La pieza se ha completado con éxito."
                    data:
                      image: "/api/camera_proxy/{{ json_name(states_trigger.input_camera_entity) }}"
                      clickAction: !input dashboard_url

              # Estado: Pausado
              - conditions:
                  - condition: template
                    value_template: "{{ trigger.to_state.state == 'paused' }}"
                sequence:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    title: "⏸️ Impresión Pausada"
                    message: "La impresora se encuentra en estado de pausa."
                    data:
                      image: "/api/camera_proxy/{{ json_name(states_trigger.input_camera_entity) }}"
                      clickAction: !input dashboard_url

              # Estado: Error
              - conditions:
                  - condition: template
                    value_template: "{{ trigger.to_state.state == 'error' }}"
                sequence:
                  - domain: mobile_app
                    type: notify
                    device_id: !input notify_device
                    title: "⚠️ Error en la Impresora"
                    message: "Motivo: {{ states(!input error_status_reason_entity) | default('Desconocido') }}"
                    data:
                      image: "/api/camera_proxy/{{ json_name(states_trigger.input_camera_entity) }}"
                      clickAction: !input dashboard_url
